# Optional provider API keys. Prefer each CLI's interactive login instead.
# Set these in the OS user or service-account environment; never commit real values
# or put them in task prompts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional executable overrides when a CLI is not on PATH (read as <NAME>_COMMAND).
CLAUDE_COMMAND=claude
CODEX_COMMAND=codex
COPILOT_COMMAND=copilot
GH_COMMAND=gh

# Repository the -DryRun smoke tests read from (any repository the gh account can read).
AGENT_TEST_REPOSITORY=
